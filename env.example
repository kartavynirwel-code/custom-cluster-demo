# Copy to .env and edit for local runs:
#   docker run --env-file .env -p 8080:80 pod-info-frontend
# In Kubernetes, POD_NAME / POD_NAMESPACE / POD_IP / NODE_NAME are injected
# automatically from the Downward API (see k8s/deployment.yaml).

APP_TITLE=Pod Info Frontend
APP_ENV=local
POD_NAME=local-pod
POD_NAMESPACE=default
POD_IP=127.0.0.1
NODE_NAME=local-machine
